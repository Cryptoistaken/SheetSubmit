{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sheetsubmit",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "durable_objects": {
    "bindings": [
      { "name": "INDEX", "class_name": "IndexDO" },
      { "name": "FILES", "class_name": "FileDO" },
      { "name": "POOLS", "class_name": "PoolDO" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IndexDO", "FileDO", "PoolDO"] }],
  "triggers": { "crons": ["0 */6 * * *"] },
  "workers_dev": true,
  "vars": { "FRONTEND_URL": "", "HITOOLS_CHECK_URL": "https://hitools.pro/api/check-live-uid", "WORKER_URL": "sheetsubmit.traderspopy.workers.dev" }
}
